---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const destination = `${base}resumen`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Redirigiendo al resumen</title>
  </head>
  <body>
    <p>La sección ahora se llama <a href={destination}>Resumen</a>.</p>
  </body>
</html>
